{
  "schema_version": 1,
  "brand": "audi",
  "api_families": {
    "cariad": {
      "auth": "auth0",
      "priority": 10,
      "host_owner": "audi_auth_session",
      "notes": "Region host resolved by existing Audi adapter; not configurable as arbitrary URL.",
      "executor": "cariad_v1"
    },
    "graphql": {
      "auth": "auth0",
      "priority": 10,
      "host_owner": "audi_auth_session",
      "notes": "Reviewed read-only identity transport; existing inventory lifecycle owns requests.",
      "executor": "graphql_v1"
    },
    "eu_data_act": {
      "auth": "eu_data_act",
      "priority": 30,
      "host_owner": "authorized_data_act_portal_session",
      "notes": "Read-only dataset provider; no control or generic request executor.",
      "observations": {
        "506cb83e-f99f-3af3-bbeb-0429b69a78d9": {
          "field": "battery_state_report.soc",
          "attribute": "stateOfCharge"
        },
        "ae0294b4-1286-3e98-a818-1485b8d88430": {
          "field": "state_of_charge",
          "attribute": "stateOfCharge"
        }
      }
    },
    "mbb": {
      "auth": "legacy",
      "priority": 20,
      "host_owner": "legacy_home_region",
      "notes": "Independent V3 legacy executor, reviewed home region, climate and RLU controls.",
      "executor": "mbb_legacy_v1"
    }
  },
